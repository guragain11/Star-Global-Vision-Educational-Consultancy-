# Supabase — powers /admin, the blog and success stories.
# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). Restart the dev server after editing.
#
# The site runs without these: blog and success stories fall back to the seed
# content in src/data/content.ts, and /admin shows setup instructions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public origin of this deployment, no trailing slash. Drives the absolute
# og:image / og:url / canonical tags and the URLs in /sitemap.xml.
#
# Leave it blank in production: the code already defaults to
# https://starglobalvision.com. Set it only on a preview or staging build, so
# its tags point at that build instead of at production.
VITE_SITE_URL=
